# Copy to .env for local development. Never commit the populated file.
ENVIRONMENT=development
DEBUG=true
ENABLE_DOCS=true
SECRET_KEY=replace-with-a-random-64-character-value
DATABASE_URL=postgresql+psycopg://hms:hms@localhost:5432/hms
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=10
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true

# Optional email delivery for password-reset messages
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourhotel.example
SMTP_USE_TLS=true

# Production-only examples
# ENVIRONMENT=production
# DEBUG=false
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# DATABASE_URL=postgresql+psycopg://user:strong-password@db:5432/hms
